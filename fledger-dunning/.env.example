# ==============================================================================
# FLEDGER DUNNING — Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=8086
APP_ENV=development
LOG_LEVEL=debug

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fledger_dunning
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# JWT Authentication
JWT_SECRET=fledger-super-secure-jwt-secret-key-2026

# Webhook Secrets
PAY_WEBHOOK_SECRET=dunning-super-secret-key-2026

# WhatsApp Gateway Provider Configuration
# Options: MOCK, BAILEYS, META_CLOUD
WA_PROVIDER=MOCK
WA_JITTER_MIN_SECONDS=3
WA_JITTER_MAX_SECONDS=8

# Upstream Ecosystem Microservices URLs
CORE_BASE_URL=http://localhost:8081
FLEET_BASE_URL=http://localhost:8082
PAY_BASE_URL=http://localhost:8083
FORCE_BASE_URL=http://localhost:8084
ORDER_BASE_URL=http://localhost:8085
