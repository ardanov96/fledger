# =============================================================================
# FMCG Wallet — Environment Configuration (example)
# Copy to .env and fill in real values. NEVER commit .env
# =============================================================================

# --- Application ---
APP_NAME=fmcg-wallet
APP_ENV=development       # development | staging | production
APP_PORT=8080
APP_VERSION=0.0.0
APP_LOG_LEVEL=info        # debug | info | warn | error
APP_LOG_FORMAT=json       # json | text
APP_TZ=Asia/Jakarta

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fmcg_wallet
DB_USER=fmcg
DB_PASSWORD=changeme
DB_SSLMODE=disable        # require in production
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_STATEMENT_TIMEOUT=10s

# --- Redis (cache + asynq broker) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# --- NATS JetStream ---
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=FMCG
NATS_STREAM_SUBJECTS=fmcg.>
NATS_ACK_WAIT=30s
NATS_MAX_DELIVER=5

# --- Auth (JWT) ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=fmcg-wallet
JWT_AUDIENCE=fmcg-wallet-api

# --- Bcrypt ---
BCRYPT_COST=12

# --- Rate Limiting ---
# Per-IP rate limit on /v1/auth/login (brute-force defense, Sprint 14)
RATELIMIT_LOGIN_ENABLED=false
RATELIMIT_LOGIN_RPS=5
RATELIMIT_LOGIN_BURST=10

# Multi-tier rate limit on /v1/* (Sprint 14 follow-up)
# Per-IP + per-user + per-tenant token buckets
RATELIMIT_GLOBAL_ENABLED=false
RATELIMIT_GLOBAL_RPS=50
RATELIMIT_GLOBAL_BURST=100
RATELIMIT_GLOBAL_TENANT_RPS=500
RATELIMIT_GLOBAL_TENANT_BURST=1000

# Tighter limits for /v1/transfers (Sprint 14 follow-up)
RATELIMIT_TRANSFER_ENABLED=false
RATELIMIT_TRANSFER_RPS=10
RATELIMIT_TRANSFER_BURST=30

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=fmcg-wallet-api
OTEL_SAMPLER_RATIO=0.1     # 10% success traces, 100% errors
METRICS_ENABLED=true
METRICS_PATH=/metrics

# --- Tenant (single-tenant mode for now) ---
TENANT_DEFAULT_ID=00000000-0000-0000-0000-000000000001
MULTI_TENANT=false

# --- Payment Gateway (Midtrans/Xendit - sandbox) ---
# PAYMENT_GATEWAY_PROVIDER=midtrans
# PAYMENT_GATEWAY_API_KEY=
# PAYMENT_GATEWAY_ENV=sandbox
# PAYMENT_GATEWAY_WEBHOOK_SECRET=

# --- Frontend (used by CORS) ---
WEB_ORIGIN=http://localhost:3000
